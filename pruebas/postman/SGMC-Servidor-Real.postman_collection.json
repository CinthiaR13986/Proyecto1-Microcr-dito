              "raw": "{{base_url}}/clientes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clientes"
              ]
            },
            "description": "Alta de un cliente ficticio. La identificación incluye {{$timestamp}} para que la colección se pueda volver a correr sin chocar con el 422 de identificación duplicada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Gabriela Pérez López\",\n  \"identificacion\": \"DPI-{{$timestamp}}\",\n  \"contacto\": {\n    \"telefono\": \"+502 5555-1234\",\n    \"email\": \"ana.perez@correo.gt\",\n    \"direccion\": \"0 avenida 0-00, zona 1, Guatemala\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', function () { pm.response.to.have.status(201); });",
                  "const cuerpo = pm.response.json();",
                  "pm.test('devuelve clienteId con formato CL-###', function () {",
                  "    pm.expect(cuerpo.clienteId).to.match(/^CL-\\d{3,8}$/);",
                  "});",
                  "pm.collectionVariables.set('clienteId', cuerpo.clienteId);"
                ]
