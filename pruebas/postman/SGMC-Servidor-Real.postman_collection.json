    {
      "name": "4. Pagos",
      "item": [
        {
          "name": "201 · Registrar pago de la cuota 1 (a tiempo)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pago1Key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', function () { pm.response.to.have.status(201); });",
                  "const cuerpo = pm.response.json();",
                  "pm.test('reproducido es false (pago nuevo)', function () { pm.expect(cuerpo.reproducido).to.eql(false); });",
                  "pm.test('el desglose suma exactamente el monto recibido', function () {",
                  "    const a = cuerpo.aplicacion;",
                  "    const suma = Number(a.gastos) + Number(a.interesMoratorio) + Number(a.interesCorriente) + Number(a.capital) + Number(a.excedente);",
                  "    pm.expect(Math.round(suma * 100)).to.eql(Math.round(Number(cuerpo.montoRecibido.valor) * 100));",
                  "});",
                  "pm.collectionVariables.set('pago1Id', cuerpo.pagoId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{pago1Key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/creditos/{{creditoId}}/pagos",
              "host": [
                "{{base_url}}"
